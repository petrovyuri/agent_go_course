# Шаблон переменных окружения для трейсинга в LangFuse.
# Скопируйте этот файл в .env и подставьте свои ключи из проекта LangFuse
# (Settings -> API Keys). Файл .env в .gitignore — не коммитьте секреты.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
